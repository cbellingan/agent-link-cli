#!/usr/bin/env bash

# Advisory check for modified dependencies after merge
if git rev-parse -q --verify ORIG_HEAD >/dev/null 2>&1; then
  CHANGED=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)
  if echo "$CHANGED" | grep -E "(pyproject\.toml|requirements\.txt)" >/dev/null 2>&1; then
    echo "⚠️  [Git Hook: post-merge] Python dependencies or packaging configuration changed."
    echo "👉 Consider running: pip install -e . or updating your venv"
  fi
fi
exit 0
