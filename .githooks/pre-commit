#!/usr/bin/env bash
set -e

echo "🔒 [Git Hook: pre-commit] Inspecting staged changes..."

# 1. Check for merge conflict markers in staged content (excluding hook code and test fixtures)
CONFLICT_MARKERS=$(git diff --cached -G"^[<]{7}[[:space:]]" --name-only | grep -v "\.githooks" | grep -v "test" || true)
if [ -n "$CONFLICT_MARKERS" ]; then
  echo "❌ [Git Hook: pre-commit] Merge conflict marker '<<<<<<<' detected in staged file(s):"
  echo "$CONFLICT_MARKERS"
  echo "👉 Resolve merge conflicts before committing. Inspect with: git diff --cached"
  exit 1
fi

# 2. Check for staged private key dumps (excluding test fixtures and hook scripts)
STAGED_KEYS=$(git diff --cached -G"(ed25519_priv_b64|x25519_priv_b64)" --name-only | grep -v "test" | grep -v "\.githooks" || true)
if [ -n "$STAGED_KEYS" ]; then
  echo "❌ [Git Hook: pre-commit] Accidental private key detected in staged non-test file(s):"
  echo "$STAGED_KEYS"
  echo "👉 Remove private keys before committing. Inspect with: git diff --cached"
  exit 1
fi

# 3. Run unit tests
echo "🧪 Running unit tests on staged content..."
python3 -m unittest discover -s tests -v

echo "✅ [Git Hook: pre-commit] Staged checks passed!"
exit 0
